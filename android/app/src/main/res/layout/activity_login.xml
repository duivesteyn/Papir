<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/papir_forest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sign_in_title"
                android:textColor="@color/papir_ivory"
                android:textSize="17sp" />

            <Button
                android:id="@+id/closeButton"
                style="@style/Papir.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/login_close"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/papir_forest"
                android:visibility="gone" />

            <!-- Shown while the sign-in happens in the system browser. -->
            <ScrollView
                android:id="@+id/awaitPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/papir_forest"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="40dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="28dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="@string/login_browser_title"
                        android:textColor="@color/papir_ivory"
                        android:textSize="24sp" />

                    <TextView
                        style="@style/Papir.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/login_browser_body" />

                    <Button
                        android:id="@+id/reopenButton"
                        style="@style/Papir.Button.Ghost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/login_browser_reopen" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/workingOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/papir_forest"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/papir_ivory" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/login_working"
                    android:textColor="@color/papir_ivory"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Papir.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_hint" />

            <Button
                android:id="@+id/pasteButton"
                style="@style/Papir.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/login_paste" />

            <Button
                android:id="@+id/switchButton"
                style="@style/Papir.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_switch_to_web" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
