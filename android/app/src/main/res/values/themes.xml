<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Forest-green window, ivory type: the same surface as the Mac app. -->
    <style name="Theme.Papir" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/papir_forest</item>
        <item name="android:colorBackground">@color/papir_forest</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/papir_forest</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Share entry: a floating card over the sender's app, dimmed behind it. -->
    <style name="Theme.Papir.Dialog" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
