<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Papir.SectionLabel" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/papir_ivory_dim</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Papir.CardTitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/papir_ivory</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Papir.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/papir_ivory_dim</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="Papir.Meta" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/papir_ivory_dim</item>
        <item name="android:alpha">0.85</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Papir.Button.Primary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/papir_forest</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Papir.Button.Ghost" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/papir_ivory</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Papir.Field" parent="">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/papir_ivory</item>
        <item name="android:textColorHint">@color/papir_ivory_dim</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:inputType">textPersonName</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

</resources>
