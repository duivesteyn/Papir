{
  "manifest_version": 3,
  "name": "Send to Papir",
  "version": "1.2",
  "description": "Send the current page or PDF to Papir for review before it reaches your Kindle.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Send to Papir",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:47821/pair*"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
